# Copy to deploy/.env and fill in real values before `docker compose up`.

# 32-byte key for encrypting kubeconfigs at rest. Generate with: openssl rand -hex 32
OMASTX_MASTER_KEY=

# First admin user, created on first run.
OMASTX_ADMIN_EMAIL=admin@example.com
OMASTX_ADMIN_PASSWORD=

# Optional: password for the bundled Postgres (defaults to "omastx").
# POSTGRES_PASSWORD=
