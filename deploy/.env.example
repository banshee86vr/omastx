# Optional overrides for local dev. With OMASTX_DEV (set by make dev / make dev-local),
# master key, admin user, and sign-in are configured automatically — no .env required.

# Override dev defaults only when you need non-default secrets (e.g. testing encryption):
# OMASTX_MASTER_KEY=

# Native dev (make dev-local / make dev-backend): Postgres from make dev-db
DATABASE_URL=postgres://omastx:omastx@localhost:5432/omastx?sslmode=disable

# Optional: password for the bundled Postgres (defaults to "omastx").
# POSTGRES_PASSWORD=
