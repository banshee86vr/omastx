# Optional overrides for local dev. With OMASTX_DEV (set by make dev / make dev-local),
# master key and passwordless dev sign-in are configured automatically — no .env required.

# Override dev defaults only when you need non-default secrets (e.g. testing encryption):
# OMASTX_MASTER_KEY=

# Native dev (make dev-local / make dev-backend): Postgres from make dev-db
DATABASE_URL=postgres://omastx:omastx@localhost:5432/omastx?sslmode=disable

# Optional: password for the bundled Postgres (defaults to "omastx").
# POSTGRES_PASSWORD=

# Optional: test real GitHub OAuth locally (backend reads these from deploy/.env).
# When unset, make dev-local uses passwordless dev-login instead.
# OMASTX_GITHUB_CLIENT_ID=
# OMASTX_GITHUB_CLIENT_SECRET=
# OMASTX_GITHUB_ORG=your-org   # organization slug, or your GitHub username for solo installs
# OMASTX_BASE_URL=http://localhost:5173

# Production GitHub OAuth (required when OMASTX_DEV is not set):
# OMASTX_GITHUB_CLIENT_ID=
# OMASTX_GITHUB_CLIENT_SECRET=
# OMASTX_GITHUB_ORG=your-org   # GitHub organization slug, or your personal username for solo installs
# OMASTX_BASE_URL=https://omastx.example.com
